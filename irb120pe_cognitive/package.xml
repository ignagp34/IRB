<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>irb120pe_cognitive</name>
  <version>0.1.0</version>
  <description>LangChain reasoning, perception adapters, planning-scene sync, and safe action tools for the IRB-120 sorting demo.</description>
  <maintainer email="team@example.com">Cognitive IRB-120 Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>irb120pe_cognitive_interfaces</depend>
  <depend>ros2srrc_data</depend>
  <depend>linkattacher_msgs</depend>

  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
